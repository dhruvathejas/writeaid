# ─────────────────────────────────────────────────────────────
#  WriteAid secrets. This file is in .gitignore — it never goes to GitHub.
# ─────────────────────────────────────────────────────────────

# Signs login cookies. Already filled in with a random value — leave it.
SESSION_SECRET=   # generate with: openssl rand -base64 48

# Where the app runs. Keep as-is for your computer.
APP_URL=http://localhost:3000

# ── OpenAI — handwriting reviews + Inky the coach chat ──
# Get a key at https://platform.openai.com/api-keys (paid: a tiny amount per photo or chat)
OPENAI_API_KEY=
# Optional: change the model. gpt-5-mini is cheap, reads photos, and is good at this.
OPENAI_MODEL=gpt-5-mini

# ── Google sign-in ("Connect my Gmail") ──
# https://console.cloud.google.com/apis/credentials → Create OAuth client ID → Web application
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Resend — welcome, forgot-passcode and weekly parent report emails ──
RESEND_API_KEY=

# "onboarding@resend.dev" only delivers to the email that owns your Resend account.
# To email anyone else, verify a domain in Resend and use e.g. WriteAid <hello@yourdomain.com>
RESEND_FROM_EMAIL=WriteAid <onboarding@resend.dev>
